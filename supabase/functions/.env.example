# Server-side Edge Function secrets. Do not commit the filled .env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same base64 32-byte key as the Nuxt NUXT_GOOGLE_COOKIE_KEY.
GOOGLE_GRANT_KEY=
# Separate random secret shared only with the Cron job in Supabase Vault.
GOOGLE_SYNC_SECRET=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Supabase.
# Enable PageSpeed Insights API and Chrome UX Report API in Google Cloud.
# These keys remain server-only; restrict each key to its API.
GOOGLE_PAGESPEED_KEY=
GOOGLE_CRUX_KEY=

# Bing Webmaster OAuth client (same client as Nuxt), read-only reporting.
BING_CLIENT_ID=
BING_CLIENT_SECRET=
# Same base64 32-byte key as NUXT_BING_COOKIE_KEY.
BING_GRANT_KEY=
# Separate secret shared with Cron Vault htp_bing_sync_secret.
BING_SYNC_SECRET=
