# These defaults already connect to the deployed HTP API and public Auth project.
# Public values below can be used in the browser.
NUXT_API_BASE_URL=https://htp-api-kerry-hatcher.fly.dev
NUXT_PUBLIC_API_BASE_URL=https://htp-api-kerry-hatcher.fly.dev
NUXT_PUBLIC_SUPABASE_URL=https://raxuvdbdfmmtpqjcafcq.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Loul540Y3Oj_qIojV0kr0w_Jq5vhn5H

# Server-only Google web OAuth credentials (never NUXT_PUBLIC_).
NUXT_APP_ORIGIN=http://localhost:3001
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Generate once: openssl rand -base64 32
NUXT_GOOGLE_COOKIE_KEY=
# Server-only. Never use NUXT_PUBLIC_ for this key.
NUXT_SUPABASE_SERVICE_ROLE_KEY=
# The Edge Function GOOGLE_GRANT_KEY must match NUXT_GOOGLE_COOKIE_KEY.
# Enable Google Search Console API (also URL Inspection) in this OAuth project.
# Add webmasters.readonly to the consent configuration. Existing browser
# connections need renewed consent through Connections.

# Server-only Bing Webmaster OAuth client, registered under Settings > API Access.
# Register the redirect URI: <NUXT_APP_ORIGIN>/auth/bing/callback
NUXT_BING_CLIENT_ID=
NUXT_BING_CLIENT_SECRET=
# Generate once with openssl rand -base64 32; match BING_GRANT_KEY in bing-sync.
NUXT_BING_COOKIE_KEY=
