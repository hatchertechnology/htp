{
  // Source-only opt-in candidate. No routes, domains, credentials or deployment wiring.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htp-web-static-oauth-candidate",
  "main": "edge/static-oauth.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs/traces can contain OAuth callback query strings.
  "observability": { "enabled": false },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/google/connect", "/auth/google/callback",
      "/api/bing/connect", "/auth/bing/callback"
    ]
  }
}
